# Server-side only. Never prefix with NEXT_PUBLIC_.

# Option 1: Groq (direct). Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Option 2: Vercel AI Gateway (used only if GROQ_API_KEY is not set).
# On Vercel, OIDC authenticates automatically once the project is linked.
# AI_GATEWAY_API_KEY=

# Optional: override the model id.
# Groq default: openai/gpt-oss-120b   Gateway default: anthropic/claude-sonnet-5.5
# BRIEFWISE_MODEL=
